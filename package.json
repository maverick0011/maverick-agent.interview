{
  "name": "maverick-ai",
  "productName": "Maverick AI",
  "version": "1.0.0",
  "description": "Private, local-first macOS AI interview assistant, real-time meeting copilot, and technical interview preparation platform powered by Qwen3 8B Q4.",
  "private": true,
  "main": "electron/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist electron/dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --mac dmg --arm64",
    "electron:build:mac": "vite build && electron-builder --mac dmg zip",
    "electron:build:win": "vite build && electron-builder --win nsis portable",
    "electron:build:all": "vite build && electron-builder --mac --win",
    "backend:dev": "tsx watch backend/src/server.ts",
    "backend:start": "tsx backend/src/server.ts"
  },
  "build": {
    "appId": "in.cloudnativeacademy.interview",
    "productName": "Maverick AI - CloudNative Academy",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.3.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
