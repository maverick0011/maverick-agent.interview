# Optional additional trusted browser origins, comma-separated.
# The GitHub Pages origin and the current custom domain are preconfigured.
MAVERICK_ALLOWED_ORIGINS=

# Keep this false for browser-based access. Set true only if your Electron
# file:// renderer needs Origin: null and you understand the local-file risk.
MAVERICK_ALLOW_NULL_ORIGIN=false

# Local backend port. The server always binds to 127.0.0.1.
MAVERICK_PORT=3001
